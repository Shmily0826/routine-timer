<view class="page timer"><text class="phase">{{phase === 'work' ? '训练' : '休息'}}</text><text class="name">{{name}}</text><text class="count">第 {{group}} / {{total}} 组</text><text class="time">{{display}}</text><text class="next">下一组：{{next}}</text><view wx:if="{{!completed}}" class="controls"><button bindtap="toggle">{{paused ? '继续' : '暂停'}}</button><button bindtap="goPrevious">上一组</button><button bindtap="goNext">下一组</button></view><view wx:if="{{completed}}"><text class="done">已完成</text><view wx:if="{{summary}}" class="sum"><text>共完成 {{summary.rounds}} 组</text><text>训练 {{summary.work}} · 休息 {{summary.rest}}</text><text>总时长 {{summary.total}}</text></view><button bindtap="again">再来一次</button><button class="stop" bindtap="stop">返回首页</button></view><button wx:if="{{!completed}}" class="stop" bindtap="stop">停止 / 退出</button></view>
