<view class="page"><text class="title">已保存 Routine</text><button class="start" bindtap="save">保存当前设置</button><view wx:for="{{routines}}" wx:key="id" class="card"><text class="name">{{item.name}}</text><text class="sub">{{item.rounds.length}} 组</text><button data-index="{{index}}" bindtap="start">开始</button><button data-index="{{index}}" bindtap="rename">重命名</button><button data-index="{{index}}" bindtap="remove">删除</button></view><text wx:if="{{!routines.length}}" class="empty">还没有保存的 Routine。</text></view>
