<view class="page"><text class="title">训练历史</text><button wx:if="{{items.length}}" class="secondary" bindtap="clear">清空历史</button><view wx:if="{{stats && stats.count}}" class="card stats"><text class="name">累计统计</text><text class="sub">已完成 {{stats.count}} 次训练 · 共 {{stats.rounds}} 组</text><text class="sub">累计时长 {{stats.duration}}</text></view><view wx:for="{{items}}" wx:key="id" class="card"><text class="name">{{item.label}}</text><text class="sub">{{item.rounds}} 组 · 训练 {{item.work}} · 休息 {{item.rest}} · 共 {{item.total}}</text><text class="sub">{{item.date}}</text><button class="edit" data-index="{{index}}" bindtap="remove">删除</button></view><text wx:if="{{!items.length}}" class="empty">还没有完成的训练记录。</text></view>
