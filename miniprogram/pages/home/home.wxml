<view class="page"><view wx:if="{{recovery}}" class="card"><text class="name">发现未完成的训练</text><text class="sub">第{{recovery.round}}组 {{recovery.name}}</text><button bindtap="continue">继续训练</button><button bindtap="discard">放弃</button></view><view class="hero"><text class="eyebrow">GROUP PRACTICE</text><text class="title">分组练习计时器</text><text class="sub">设置一次，专注完成每一组。</text></view><view class="card"><view class="row"><text>总组数</text><input type="number" value="{{groups}}" maxlength="3" bindinput="onGroups" /></view><view class="row"><text>每组训练（秒）</text><input type="number" value="{{duration}}" maxlength="3" bindinput="onDuration" /></view><view class="row"><text>默认休息（秒）</text><input type="number" value="{{rest}}" maxlength="3" bindinput="onRest" /></view><view class="detail" bindtap="toggleDetail">详细设置 <text>{{expanded ? '收起' : '展开'}}</text></view><block wx:if="{{expanded}}"><view wx:for="{{items}}" wx:key="index" class="item"><text>第{{index+1}}组</text><input value="{{item.name}}" data-index="{{index}}" bindinput="onName" placeholder="动作名称（可空）" /><input type="number" value="{{item.work}}" maxlength="3" data-index="{{index}}" bindinput="onItemWork" /><input type="number" value="{{item.rest}}" maxlength="3" data-index="{{index}}" bindinput="onItemRest" /></view></block><button class="start" bindtap="start">开始练习</button><button class="secondary" bindtap="saveRoutine">{{editId ? '保存修改' : '保存为 Routine'}}</button><button class="secondary" bindtap="routines">已保存 Routine</button><button class="secondary" bindtap="history">历史记录</button></view></view>
