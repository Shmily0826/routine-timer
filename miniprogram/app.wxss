.page{min-height:100vh;background:#f4f7fb;padding:48rpx;box-sizing:border-box;color:#172033}.hero{padding:40rpx 0}.eyebrow,.phase{color:#637083;font-size:24rpx;letter-spacing:3rpx}.title{display:block;font-size:52rpx;font-weight:700;margin:20rpx 0}.sub,.empty{color:#637083;font-size:28rpx}.card{background:#fff;border-radius:28rpx;padding:32rpx;box-shadow:0 12rpx 40rpx #12233a12}.row{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;border-bottom:1px solid #edf0f5;font-size:30rpx}.row input,.item input{width:180rpx;text-align:right}.detail{padding:30rpx 0;color:#3457d5}.detail text{float:right;color:#637083}.item{display:flex;gap:12rpx;align-items:center;padding:12rpx 0;font-size:24rpx}.item input{border:1px solid #e4e8ef;padding:8rpx}.start{margin-top:30rpx;background:#3157d8;color:white;border-radius:16rpx}.secondary,.stop{margin-top:20rpx;background:#eef2ff;color:#3157d8}.timer{text-align:center;padding-top:120rpx}.phase,.name,.count,.time,.next,.done{display:block}.name{font-size:48rpx;font-weight:700;margin:20rpx}.count,.next{color:#637083;font-size:28rpx}.time{font-size:150rpx;font-weight:700;letter-spacing:4rpx;margin:70rpx 0}.controls{display:flex;gap:12rpx;margin-top:70rpx}.controls button{flex:1;font-size:24rpx}.done{color:#16805c;font-size:48rpx;font-weight:700;margin-top:60rpx}.sum{display:block;color:#637083;font-size:28rpx;margin:14rpx 0}.sum text{display:block}
