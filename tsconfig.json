{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types", "./node_modules"],
    "types": ["miniprogram-api-typings"]
  },
  "include": ["src/**/*.ts", "miniprogram/**/*.ts"]
}
